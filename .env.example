# Copiar este archivo como .env y completar los valores. Reiniciar Vite (npm run dev) al cambiarlos.

# Public Key de la aplicación de Mercado Pago. Tiene que ser de la MISMA aplicación que el
# Access Token configurado en el backend (mercadopago.access-token).
VITE_MP_PUBLIC_KEY=TU_PUBLIC_KEY

# Client ID de OAuth de Google para "Continuar con Google". Tiene que ser igual al
# google.oauth.client-id del backend.
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
